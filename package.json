{
  "name": "website-monitor-tool",
  "type": "module",
  "version": "0.1.2",
  "moduleResolution": "nodenext",
  "description": "Web socket powered tool to alert if a website goes down.",
  "extends": "@tsconfig/node16/tsconfig.json",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc && pnpm run copy-view",
    "copy-view": "ncp src/view build/view",
    "demo-server-start": "pnpm run build && node examples/mothership.js",
    "demo1-start": "pnpm run build && node examples/demo_website.js",
    "demo2-start": "pnpm run build && node examples/demo_website_2.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "down_detector",
    "website monitoring",
    "web sockets",
    "website downtime",
    "uptime monitoring"
  ],
  "files": [
    "build"
  ],
