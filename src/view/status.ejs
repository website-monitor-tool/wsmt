<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Status Page</title>
  <meta name="description" content="Provides real-time monitoring and status updates for registered services.">
  <meta name="keywords" content="status page, website monitoring, uptime monitoring, downtime alerts, server status">

  <meta property="og:title" content="Status Page">
  <meta property="og:description" content="Check the real-time status of registered services.">
  <meta property="og:type" content="website">

  <style>
    :root {
      --header-bg-color: #0747a6;
      --body-bg-color: #f4f5f7;

      --status-operational-color: #36b37e;
      --status-degraded-color: #a16207;
      --status-down-color: #b91c1c;

      --status-inactive-color: #c9c7c7;

      --status-operational-bg: #D1FAE5;
      --status-degraded-bg: #fef9c3;
      --status-down-bg: #fee2e2;

      --text-gray: #525c6e;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: var(--body-bg-color);
      margin: 0;
      padding: 0;
    }

    header {
      background-color: #0747a6;
      color: white;
      padding: 1.5rem 2rem;
      text-align: center;
    }

    .header-title {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
      margin: 0;
    }

    .beta-ribbon {
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(255, 255, 255, 0.45);
      border-radius: 999px;
      padding: 3px 9px;
      background: rgba(255, 255, 255, 0.14);
      color: white;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .description-details {
      background-color: #f9fafb;
      color: #4b5563;
      padding: 0.75rem;
    }

    .description-details p {
      margin: 0;
    }

    .m-0 {
      margin: 0;
    }

    .container {
      border-radius: 10px;
    }

    #main-container {
      max-width: 800px;
      margin: 2rem auto;
    }

    .summary-content {
      margin: 13px 0px 10px;
    }

    .logs-btn {
      font-size: 13px;
      font-weight: 500;
      color: #1e40af;
      background: #eff6ff;
      border: 0.5px solid #bfdbfe;
      border-radius: 8px;
      padding: 6px 14px;
      text-decoration: none;
      margin-top: 10px;
    }
    .logs-btn:hover { opacity: 0.8; }

    .component {
      display: flex;
      align-items: center;
      padding: 1rem 1rem 0.5rem 1rem;
      flex-wrap: wrap;

      border-radius: 10px;
      background-color: white;
      /* box-shadow: 0 6px 8px rgba(0, 0, 0, 0.05); */
    }

    .component:last-child {
      border-bottom: none;
    }

    .component:hover {
      filter: invert(2%);
      cursor: pointer;
    }

    .info-block {
      display: flex;
      flex-direction: row;
      gap: 0.2rem;
      justify-content: space-between;
      width: 100%;
      padding: 0px 0px 10px 0px;
    }

    .service-name {
      display: flex;
      align-items: center;
      font-weight: 600;
    }

    .uptime-badge {
      font-size: 14px;
    }

    .status {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      font-size: 15px;
      padding: 4px 10px;
      border-radius: 20px;
      font-weight: 500;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(10px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes fadeOut {
      from {
        opacity: 1;
        transform: translateY(0);
      }

      to {
        opacity: 0;
        transform: translateY(10px);
      }
    }

    .fade-in {
      animation: fadeIn 0.8s ease-out;
    }

    .fade-out {
      animation: fadeOut 0.8s ease-out;
    }

    @keyframes blink {
      0% {
        opacity: 1;
      }

      50% {
        opacity: 0.3;
      }

      100% {
        opacity: 1;
      }
    }

    .dot {
      margin-top: 4px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      animation: blink 1.2s infinite ease-in-out;
    }

    .dot.operational {
      background-color: var(--status-operational-color);
    }

    .dot.degraded {
      background-color: var(--status-degraded-color);
    }

    .dot.down {
      background-color: var(--status-down-color);
    }

    .dot.inactive {
      background-color: var(--status-inactive-color);
    }

    .status-operational {
      background-color: var(--status-operational-bg);
      color: var(--status-operational-color);
    }

    .status-degraded {
      background-color: var(--status-degraded-bg);
      color: var(--status-degraded-color);
    }

    .status-down {
      background-color: var(--status-down-bg);
      color: var(--status-down-color);
    }

    .service-count-badge {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      background-color: #007bff;
      color: white;
      height: 1.4em;
      min-width: 1.4em;
      border-radius: 50%;
      font-size: 0.7em;
    }

    h2 {
      cursor: pointer;
      width: fit-content;
      color: #172b4d;
      border-bottom: 2px solid rgb(79, 79, 255);
    }

    .divider {
      width: 100%;
      margin: 3px;
      border: none;
      border-top: 1px dotted #ddd;
    }

    .no-services {
      background-color: white;
      padding: 1rem;
      border-radius: 20px;
    }

    .visible {
      display: block;
    }

    .hidden {
      display: none;
    }

    .information-section {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .information-section svg {
      width: 1.25rem;
      height: 1.25rem;

      transition: 0.3s;
    }

    .details-content {
      background-color: white;
      max-height: 1000px;
      transition: max-height 0.4s ease-in-out;
      box-shadow: 0 6px 8px rgba(0, 0, 0, 0.05);
      overflow: hidden;
      border-bottom-right-radius: 10px;
      border-bottom-left-radius: 10px;
    }

    .text-gray {
      color: var(--text-gray);
    }

    .status-bar-grid {
      display: grid;
      grid-template-columns: repeat(30, minmax(0, 1fr));
      gap: 2px;
      height: 24px;
      background-color: #e5e7eb;
      padding: 3px;
      border-radius: 0.25rem;
    }

    .status-bar {
      height: 100%;
      border-radius: 2px;
    }

    .expanded {
      padding: 0rem 1rem 1rem 1rem !important;
    }

    .status-bar-online {
      background-color: #22c55e;
    }

    .status-bar-offline {
      background-color: #ef4444;
    }

    .desc-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 10px;
  width: 100%;
}
.desc-tile {
  background: #f5f5f4; /* or your gray-50 equivalent */
  border-radius: 8px;
  padding: 12px 14px;
  min-width: 0;
}
.desc-tile-label {
  font-size: 11px;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #6b7280;
  margin-bottom: 5px;
}
.desc-tile-value {
  font-size: 15px;
  font-weight: 500;
  color: #111827;
}
.desc-tile-value.green { color: #3B6D11; }

    .status-bar-degraded {
      background-color: #f59e0b;
    }

    .status-bar-inactive {
      background-color: #c9c7c7;
    }

    @media (max-width: 600px) {
      .component {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.5rem;
      }

      .status {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

<body>

  <header>
    <h1 class="header-title">
      WASM Monitor Tool
      <!-- <span class="beta-ribbon" title="Early beta: many changes are coming soon, including alerts, Discord notifications, and webhook calls.">Early Beta</span> -->
    </h1>
    <% if (headerStatus) { %>
      <p>
        <%- headerStatus %>
      </p>
      <% } %>
  </header>

  <div id="main-container">
    <div id="user-navbar">
      <h2 style="padding: 5px;">Service Status <span id="total-services-count" class="service-count-badge">
          <%= count %>
        </span>
      </h2>
    </div>

    <div class="no-services <%= Object.keys(service).length > 0 ? 'hidden' : 'show' %>">
      No registered services found, <a href="https://github.com/website-monitor-tool/wsmt#4-connect-a-client">register your first service.</a>
    </div>

    <div class="container" id="service-container">
      <% Object.keys(service).forEach(key=> {
        const { initialConnect, serviceDescription, onlineSinceHumanReadable, lastSeenHumanReadable, status, statusText
        }
        =
        service[key];
        %>
        <div class="summary-content">
            <div class="component" onclick="openComponent(this)" id="<%= key %>"
              title="<%= serviceDescription || 'No description provided' %>">
              <div class="info-block">
                <!-- Service name with icon -->
                <span class="service-name">
                  <%= key %>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor"
                      class="bi bi-info-circle" style="margin-left: 6px;" viewBox="0 0 16 16">
                      <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
                      <path
                        d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0" />
                    </svg>
                </span>

                <div class="status status-<%= status %>">
                  <span class="dot <%= status %>"></span>
                  <span class="status-text">
                    <%= statusText %>
                  </span>
                </div>
              </div>

              <hr class="divider">

              <div class="information-section">
                <% if (onlineSinceHumanReadable) { %>
                  <span style="display:inline-flex; align-items:center; gap:6px;">
                  <svg width="20" height="20" viewBox="0 0 34 38" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M4 22 Q17 8 30 22" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round"/>
                    <path d="M9 28 Q17 20 25 28" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round"/>
                    <circle cx="17" cy="34" r="2.5" fill="#1D9E75"/>
                  </svg>
                  Online for <%= onlineSinceHumanReadable %>
                </span>
                  <% } else { %>


                    <span style="display:inline-flex; align-items:center; gap:6px;">
  <svg width="20" height="20" viewBox="0 0 34 38" fill="none" xmlns="http://www.w3.org/2000/svg">
    <path d="M4 22 Q17 8 30 22" stroke="currentColor" stroke-opacity="0.4" stroke-width="2.5" stroke-linecap="round"/>
    <path d="M9 28 Q17 20 25 28" stroke="currentColor" stroke-opacity="0.4" stroke-width="2.5" stroke-linecap="round"/>
    <circle cx="17" cy="34" r="2.5" fill="currentColor" fill-opacity="0.4"/>
    <line x1="2" y1="36" x2="32" y2="6" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round"/>
  </svg>
  Offline for <%= lastSeenHumanReadable %>
</span>
                    <% } %>

                      <svg class="arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                        xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
              </div>
            </div>

            <div class="details-content">

    <% if (isPersistent) { %>
  <div class="status-bar-grid-container">
    <h3 style="margin: 0; padding: 10px 5px; font-size: 0.875rem;" class="text-gray">
      Recent Uptime (Last 30 Days)
    </h3>

    <div class="status-bar-grid">
<% const MS_IN_DAY = 86400000;
   const serviceData = service[key];

   const registeredDate = new Date(serviceData.initialConnect);
   const today = new Date();

   const todayDate = new Date(Date.UTC(
    today.getUTCFullYear(),
    today.getUTCMonth(),
    today.getUTCDate()
  ));

  const registeredDay = !isNaN(registeredDate.getTime())
    ? new Date(Date.UTC(
        registeredDate.getUTCFullYear(),
        registeredDate.getUTCMonth(),
        registeredDate.getUTCDate()
      ))
    : null;

  const rollingStartDate = new Date(todayDate);
  rollingStartDate.setUTCDate(todayDate.getUTCDate() - 29);

  const startDate = registeredDay && registeredDay > rollingStartDate
    ? new Date(registeredDay)
    : new Date(rollingStartDate);

   for (let i = 0; i < 30; i++) {

     const date = new Date(startDate);
     date.setUTCDate(startDate.getUTCDate() + i);

     const dayStr = date.toISOString().split('T')[0];

     let statusClass = '';
     let title = dayStr;

     // beyond yesterday → inactive (no future / no today)
     if (date > todayDate) {
       statusClass = 'status-bar-inactive';
       title += ' | No data available yet';
     } else if (registeredDay && date < registeredDay) {
       statusClass = 'status-bar-inactive';
       title += ' | Not registered yet';
     } else {

       const dayData = downtimes.find(d =>
         d.service_id === serviceData.id && d.day === dayStr
       );

       if (!dayData) {
         statusClass = 'status-bar-online';
         title += ' | 100% uptime';
       } else {
         const downtime = dayData.total_downtime_ms || 0;
         const uptimePercent = Math.max(0, 100 - (downtime / MS_IN_DAY) * 100).toFixed(2);

         statusClass =
           dayData.status === 'online' ? 'status-bar-online' :
           dayData.status === 'offline' ? 'status-bar-offline' :
           'status-bar-degraded';

         title += ' | Uptime: ' + uptimePercent + '% | Downtime: ' + (downtime / 60000).toFixed(1) + ' min';
       }
     }
%>
  <div class="status-bar-day <%= statusClass %>" title="<%= title %>"></div>
<% } %>
</div>
  </div>

  <% } %>

  <h3 class="text-gray uppercase" style="font-size: 0.875rem; margin: 0; padding: 10px 5px;">
    Additional Information
  </h3>

  <div class="desc-grid">
  <div class="desc-tile">
    <div class="desc-tile-label">Registered</div>
    <div class="desc-tile-value">
      <%= new Date(initialConnect).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
      at
      <%= new Date(initialConnect).toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' }) %>
    </div>
  </div>
  <div class="desc-tile">
    <div class="desc-tile-label">Average latency</div>
    <div class="desc-tile-value green">-- ms</div>
  </div>
</div>

  <div style="display: flex; justify-content: flex-end;">
  <a href="/status/id" class="logs-btn">
    View full logs <span class="logs-btn-arrow">↗</span>
  </a>
</div>
</div>
        </div>
        <% }) %>

    </div>
  </div>
  </div>

  <script>
    const serviceCounter = document.getElementById("total-services-count");
    const detailedView = true;
    let noServicesEverAdded = true;

    if (detailedView) {
      const contentArray = document.getElementsByClassName("summary-content");
      for (let i = 0; i < contentArray.length; i++) {
        const element = contentArray[i];

        const component = element.querySelector(".component");
        const arrow = component.querySelector(".arrow");

        const detailsContent = element.querySelector(".details-content");

        detailsContent.classList.add("expanded");
        arrow.style.transform = "rotate(90deg)";
      }
    }

    function openComponent(element) {
      const arrow = element.querySelector(".arrow");
      const contentDetails = element.nextElementSibling
      const isOpen = contentDetails.classList.contains("expanded");

      if (isOpen) {
        contentDetails.style.maxHeight = "0px";
        setTimeout(() => { contentDetails.classList.remove("expanded") }, 400)
      } else {
        contentDetails.style.maxHeight = "1000px";
        contentDetails.classList.add("expanded");
      }
    }

    function replaceChars(s) {
      const replace = {
        "&": "&amp;",
        '"': "&quot;",
        "'": "&#039;",
        "<": "&lt;",
        ">": "&gt;",
      };
      return s.replace(/[&"'<>]/g, (c) => replace[c]);
    }

    function fetchStatus() {
      fetch('/api/status')
        .then(response => response.json())
        .then(services => {
          const container = document.getElementById('service-container');
          const receivedKeys = new Set(Object.keys(services));

          // Remove services not in the response with fade-out
          const currentComponents = container.querySelectorAll('.component');
          currentComponents.forEach(component => {
            if (!receivedKeys.has(component.id)) {
              serviceCounter.innerText = parseInt(serviceCounter.innerText) - 1;
              const wrapper = component.closest('.summary-content') || component;
              wrapper.classList.add('fade-out');
              setTimeout(() => wrapper.remove(), 800);
            }
          });

          if (receivedKeys.size == 0 && !noServicesEverAdded && Object.keys(services).length == 0) {
            const noServiceDiv = document.getElementsByClassName("no-services")[0];
            noServiceDiv.classList.replace("hidden", "show")
            noServiceDiv.innerHTML = "No registered services found, <a href='https://github.com/website-monitor-tool/wsmt#4-connect-a-client'>register one?</a>"
          }

          // Add or update services
          Object.keys(services).forEach(key => {
            if (noServicesEverAdded) noServicesEverAdded = false;

            const serviceElement = document.getElementById(key);
            const service = services[key];

            if (!serviceElement) {
              serviceCounter.innerText = parseInt(serviceCounter.innerText) + 1;

              noServiceDiv = document.getElementsByClassName("no-services")[0];

              if (noServiceDiv) {
                noServiceDiv.classList.replace("show", "hidden");
              }

              const div = document.createElement('div');
              div.className = 'component fade-in';
              div.id = key;
              div.title = service.serviceDescription || 'No description provided';

              let uptimeBadge = '';
if (service.onlineSinceHumanReadable) {
  uptimeBadge = `
    <span class="uptime-badge">
      <svg width="16" height="18" viewBox="0 0 34 38" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 22 Q17 8 30 22" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M9 28 Q17 20 25 28" stroke="#1D9E75" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="17" cy="34" r="2.5" fill="#1D9E75"/>
      </svg>
      Online for ${service.onlineSinceHumanReadable}
    </span>`;
} else {
  uptimeBadge = `
    <span class="uptime-badge">
      <svg width="16" height="18" viewBox="0 0 34 38" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 22 Q17 8 30 22" stroke="currentColor" stroke-opacity="0.4" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M9 28 Q17 20 25 28" stroke="currentColor" stroke-opacity="0.4" stroke-width="2.5" stroke-linecap="round"/>
        <circle cx="17" cy="34" r="2.5" fill="currentColor" fill-opacity="0.4"/>
        <line x1="2" y1="36" x2="32" y2="6" stroke="#E24B4A" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
      Offline for ${service.lastSeenHumanReadable}
    </span>`;
}

              div.innerHTML = `
      <div class="info-block">
        <span class="service-name">${replaceChars(key)}</span>
        <div class="status status-${service.status}">
        <span class="dot ${service.status}"></span>
        <span class="status-text">${service.statusText}</span>
      </div>
      </div>
      <hr class="divider">
      <div class="information-section">
        ${uptimeBadge}
      </div>
    `;
              container.appendChild(div);
            } else {
              const statusDiv = serviceElement.querySelector('.status');
              const dot = serviceElement.querySelector('.dot');
              const statusText = serviceElement.querySelector('.status-text');

              statusDiv.className = statusDiv.className.replace(/status-\S+/g, '').trim();
              statusDiv.classList.add(`status-${service.status}`);

              dot.className = `dot ${service.status}`;
              statusText.textContent = service.statusText;
            }
          });

        })
        .catch(err => {
          console.error('Error fetching status:', err);
        });
    }

    // Poll every 5 seconds
    setInterval(fetchStatus, 5000);
    fetchStatus();

    const matches = document.querySelectorAll(".component");

    const goToWebsite = (event) => {
      if (event.ctrlkey || event.metaKey) {
        console.log("TODO: goto website.");
      }
    }

    matches.forEach((result) => {
      result.addEventListener("click", goToWebsite);
    });
  </script>

</body>

</html>
